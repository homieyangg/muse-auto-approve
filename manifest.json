{
  "manifest_version": 3,
  "name": "Auto Approve for Muse",
  "version": "1.0.0",
  "description": "muse.ai 跳出審批卡時自動按允許，包含其他聊天室的審批。非官方工具，與 Meta 無關。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Auto Approve for Muse",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://muse.ai/*", "https://*.muse.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
